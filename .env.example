# =============================================================================
# FitLens Environment Variables
# Copy this file to .env and configure your values before deploying.
# =============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Gemini API Key (Required for Stage 0 Live Research, Stage 1/2 Multi-Model Analysis, and Audio Briefings)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# TigerData / Tiger Cloud PostgreSQL Connection String (Optional)
# If provided, FitLens stores prospects and audit records in TigerData (Tiger Cloud PostgreSQL)
# Format: postgres://tsdbadmin:password@host.tigerdata.cloud:5432/tsdb?sslmode=require
# If omitted or left empty, FitLens automatically falls back to local data/prospects_db.json
TIGERDATA_DATABASE_URL=

# Public Application URL (Used for CORS and canonical URL resolution, e.g. https://fitlens.yourdomain.com)
APP_URL=http://localhost:3000
