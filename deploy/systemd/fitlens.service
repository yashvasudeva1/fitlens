# =============================================================================
# Systemd Service Unit for FitLens
# Place in: /etc/systemd/system/fitlens.service
# Enable with: sudo systemctl enable fitlens
# Start with:  sudo systemctl start fitlens
# =============================================================================

[Unit]
Description=FitLens IOMETE Account Fit Analyzer (Full-Stack Production Server)
Documentation=https://github.com/your-username/fitlens
After=network.target

[Service]
Type=simple
User=fitlens
Group=fitlens
WorkingDirectory=/opt/fitlens
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
Environment=APP_ROOT=/opt/fitlens
EnvironmentFile=-/opt/fitlens/.env
ExecStart=/usr/bin/node /opt/fitlens/dist-server/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fitlens

# Security sandbox hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
